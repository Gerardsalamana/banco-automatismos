rules_version = '2';
// Cada usuario solo puede leer y escribir sus propios planos, y solo después de confirmar su correo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/planos/{plano} {
      allow read, delete: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
      allow create, update: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['name', 'updated', 'n', 'meta', 'doc'])
        && request.resource.data.doc is string && request.resource.data.doc.size() < 900000;
    }
  }
}
